# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="AI Evaluation Platform"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (only used for password-reset / new-account mail; safe to leave as-is locally)
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# --- Database -----------------------------------------------------------
# Default: SQLite, so `fastapi dev` / pytest work with zero external services.
# `docker compose up` overrides this to Postgres (see compose.yml) -- that is
# the primary, documented way to run the project; see README.md.
DATABASE_URL=sqlite:///./app.db

# Only read by docker compose (the "db" service + the Postgres DATABASE_URL
# override in compose.yml); irrelevant when running with the sqlite default above.
POSTGRES_PASSWORD=changethis
